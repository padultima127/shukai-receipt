rules_version = '2';
// 周回レシート図鑑の Firestore セキュリティルール
// - 閲覧: 承認済み（approved）の編成は誰でも読める。承認待ちは本人と管理者だけ
// - 登録: Googleログイン必須。必ず承認待ちで作られ、1分に1件まで、項目と文字数をチェック
// - 承認・却下: 管理者だけ。削除: 管理者と、登録した本人（いつでも取り下げられる）
// - 通報: ログインしていれば送れる。読めるのは管理者だけ
service cloud.firestore {
  match /databases/{database}/documents {
    // 管理者のメールアドレス（firebase-config.js の PAD_ADMIN_EMAILS と揃える）
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['amr.ultima127@gmail.com'];
    }
    function signedIn() {
      return request.auth != null;
    }
    function shortStr(v, max) {
      return v is string && v.size() <= max;
    }
    // 登録内容の形式チェック（キーの種類・サイズ）
    function validTeam(d) {
      return d.keys().hasOnly(['id', 'userAdded', 'dungeonId', 'title', 'timeSec', 'turns', 'yields', 'members',
          'steps', 'source', 'author', 'sourceDate', 'metrics', 'plus891Choice', 'newDungeon',
          'status', 'ownerUid', 'ownerName', 'createdAt', 'icons', 'fastMode', 'times', 'badgeIcon', 'badgeId', 'partBreak', 'plus891Members'])
        && shortStr(d.title, 80)
        && shortStr(d.dungeonId, 60)
        && d.timeSec is number && d.timeSec > 0 && d.timeSec < 36000
        && d.members is list && d.members.size() >= 1 && d.members.size() <= 12
        && (!('steps' in d) || (d.steps is list && d.steps.size() <= 60))
        && (!('source' in d) || shortStr(d.source, 300))
        && (!('ownerName' in d) || shortStr(d.ownerName, 60))
        // 画像から切り抜いたキャラのアイコン（図鑑No. → 64pxのwebp）。枠の数まで
        && (!('icons' in d) || (d.icons is map && d.icons.size() <= 12))
        && (!('fastMode' in d) || d.fastMode is bool)
        && (!('times' in d) || (d.times is map && d.times.keys().hasOnly(['on', 'off'])))
        && (!('badgeIcon' in d) || shortStr(d.badgeIcon, 20000))
        && (!('badgeId' in d) || d.badgeId is number)
        && (!('partBreak' in d) || validPartBreak(d.partBreak))
        && (!('plus891Members' in d) || (d.plus891Members is list && d.plus891Members.size() <= 12))
        && (!('plus891Choice' in d) || d.plus891Choice in ['', 'required', 'some', 'not-required']);
    }
    // 部位破壊の設定（できる・確定ドロップ・メモ）
    function validPartBreak(p) {
      return p is map && p.keys().hasOnly(['can', 'sure', 'note', 'sureNote'])
        && (!('can' in p) || p.can is bool) && (!('sure' in p) || p.sure is bool)
        && (!('note' in p) || shortStr(p.note, 100)) && (!('sureNote' in p) || shortStr(p.sureNote, 60));
    }
    // 連投制限: 前回の登録から60秒以上あいていること（初回はOK）
    function notTooFast(uid) {
      let before = get(/databases/$(database)/documents/users/$(uid));
      return !exists(/databases/$(database)/documents/users/$(uid))
        || before.data.lastSubmitAt < request.time - duration.value(60, 's');
    }

    match /teams/{id} {
      allow read: if resource.data.status == 'approved'
        || (signedIn() && resource.data.ownerUid == request.auth.uid)
        || isAdmin();
      allow create: if signedIn()
        && request.resource.data.status == 'pending'
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.id == id
        && validTeam(request.resource.data)
        && notTooFast(request.auth.uid)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.lastSubmitAt == request.time;
      // 管理者: 承認・却下・非公開・再公開（status）と、+891必須・部位破壊の設定
      // 本人: +891必須・部位破壊の設定はいつでも。公開中⇄本人が非公開（hidden）の切り替えだけできる（却下・承認待ちは変えられない）
      allow update: if ((isAdmin()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'plus891Choice', 'partBreak', 'plus891Members'])
          && request.resource.data.status in ['approved', 'rejected', 'pending', 'hidden'])
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedAt', 'plus891Choice', 'partBreak', 'plus891Members'])
          && (request.resource.data.status == resource.data.status
            || (resource.data.status in ['approved', 'hidden'] && request.resource.data.status in ['approved', 'hidden']))))
        && (!('partBreak' in request.resource.data) || validPartBreak(request.resource.data.partBreak))
        && (!('plus891Choice' in request.resource.data) || request.resource.data.plus891Choice in ['', 'required', 'some', 'not-required']);
      // 削除（取り下げ）: 管理者、または登録した本人ならいつでも（承認待ち・公開中・非公開どれでも）
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // 初期データ（サイトに最初から入っている編成）の +891必須・部位破壊の上書き。誰でも読める・書けるのは管理者だけ
    match /overrides/{id} {
      allow read: if true;
      allow write: if isAdmin()
        && request.resource.data.keys().hasOnly(['plus891Choice', 'partBreak', 'plus891Members', 'updatedAt'])
        && (!('partBreak' in request.resource.data) || validPartBreak(request.resource.data.partBreak))
        && (!('plus891Choice' in request.resource.data) || request.resource.data.plus891Choice in ['', 'required', 'some', 'not-required']);
    }

    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['lastSubmitAt'])
        && request.resource.data.lastSubmitAt == request.time;
    }

    // 代用の評価: 誰でも読める。書けるのは本人の票だけ（ドキュメントIDの末尾が自分のuid）
    match /subVotes/{id} {
      allow read: if true;
      allow create, update: if signedIn()
        && id.matches('.*_' + request.auth.uid)
        && request.resource.data.keys().hasOnly(['teamId', 'baseNo', 'candFamily', 'ok', 'uid', 'at', 'reason', 'note'])
        && (!('reason' in request.resource.data) || shortStr(request.resource.data.reason, 30))
        && (!('note' in request.resource.data) || shortStr(request.resource.data.note, 200))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.ok is bool
        && shortStr(request.resource.data.teamId, 80)
        && request.resource.data.baseNo is number
        && request.resource.data.candFamily is number
        && request.resource.data.at == request.time;
      allow delete: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
    }

    // 感想・要望: ログインなしでも送れる（文字数を制限）。読む・消すのは管理者だけ
    match /feedback/{id} {
      allow create: if request.resource.data.keys().hasOnly(['text', 'uid', 'createdAt', 'contact'])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 1000
        && (!('contact' in request.resource.data) || shortStr(request.resource.data.contact, 60))
        && request.resource.data.createdAt == request.time
        && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
      allow read, delete: if isAdmin();
    }

    match /reports/{id} {
      allow read, delete: if isAdmin();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['teamId', 'reason', 'reporterUid', 'createdAt'])
        && request.resource.data.reporterUid == request.auth.uid
        && shortStr(request.resource.data.reason, 500)
        && request.resource.data.createdAt == request.time;
    }
  }
}
